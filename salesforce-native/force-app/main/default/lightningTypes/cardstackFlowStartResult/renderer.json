{
  "renderer" : {
    "componentOverrides" : {
      "$" : {
        "definition" : "@widget/c/cardstackFlow",
        "attributes" : {
          "summary" : "{!$attrs.outputValues.summary}",
          "flowLabel" : "{!$attrs.outputValues.flowLabel}",
          "flowUrl" : "{!$attrs.outputValues.flowUrl}",
          "status" : "{!$attrs.outputValues.status}",
          "statusVariant" : "{!$attrs.outputValues.statusVariant}",
          "stepText" : "{!$attrs.outputValues.stepText}",
          "stepLabel" : "{!$attrs.outputValues.stepLabel}",
          "nextPrompt" : "{!$attrs.outputValues.nextPrompt}",
          "isQuickAction" : "{!$attrs.outputValues.isQuickAction}",
          "hasAnswers" : "{!$attrs.outputValues.hasAnswers}",
          "errorMessage" : "{!$attrs.outputValues.errorMessage}",
          "actionSessionId" : "{!$attrs.outputValues.actionSessionId}",
          "suggestedReplies" : "{!$attrs.outputValues.suggestedReplies}"
        }
      }
    }
  }
}