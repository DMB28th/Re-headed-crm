{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "attributes": {
            "gap": "sm"
          },
          "children": [
            {
              "definition": "tile/text",
              "attributes": {
                "text": "{!$attrs.summary}",
                "variant": "h3"
              }
            },
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "sm"
              },
              "meta": {
                "forEach": "{!$attrs.rows}",
                "forItem": "$row"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "md"
                  },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$cell}",
                        "variant": "body"
                      },
                      "meta": {
                        "forEach": "{!$row.cells}",
                        "forItem": "$cell"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
