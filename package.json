{
  "name": "cardstack",
  "private": true,
  "version": "0.0.1",
  "description": "Configurable MCP Apps for Salesforce and HubSpot — admin-designed record cards that render inside AI chat hosts.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "demo:m1": "pnpm --filter @cardstack/mcp-server demo",
    "demo:m2": "pnpm --filter @cardstack/mcp-server demo:m2",
    "demo:m2.5": "pnpm --filter @cardstack/mcp-server demo:m25"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
