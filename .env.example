# Cardstack — environment variables
# Copy to .env / set on Railway. Nothing here is required for local mock demos.

# --- Shared (Studio + MCP) ---
# Postgres — enables durable config, audit, auth, MCP tokens.
# DATABASE_URL=postgres://user:pass@host:5432/cardstack

# --- Studio auth (M7 multi-account) ---
# When BOTH are set, Studio requires SSO login. Org id = tenantId.
# BETTER_AUTH_SECRET=generate-a-long-random-string
# BETTER_AUTH_URL=https://studio.example.com
# STUDIO_URL=https://studio.example.com

# Google SSO
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# HubSpot SSO (login — separate from CRM private-app token)
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=

# Salesforce SSO
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_LOGIN_HOST=https://login.salesforce.com

# --- Legacy machine gates (auth off / CI) ---
# STUDIO_SHARED_SECRET=
# MCP_SHARED_SECRET=

# --- MCP ---
# MCP_RATE_LIMIT_PER_MIN=120
# CORS_ORIGINS=https://claude.ai,https://chatgpt.com
