{
  "name": "@cardstack/mcp-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "CARDSTACK_DEV_IDENTITY=1 tsx watch src/main.ts",
    "start": "node dist/main.js",
    "demo": "CARDSTACK_DEV_IDENTITY=1 tsx scripts/demo.ts",
    "demo:m2": "CARDSTACK_DEV_IDENTITY=1 tsx scripts/demo-m2.ts",
    "demo:m25": "CARDSTACK_DEV_IDENTITY=1 tsx scripts/demo-m25.ts",
    "demo:m3": "CARDSTACK_DEV_IDENTITY=1 tsx scripts/demo-m3.ts",
    "demo:m4": "CARDSTACK_DEV_IDENTITY=1 tsx scripts/demo-m4.ts",
    "dev:sf": "CARDSTACK_DEV_IDENTITY=1 CARDSTACK_DEV_SF_ORG=${CARDSTACK_DEV_SF_ORG:-screenflow-org} CARDSTACK_CONFIG_PATH=${CARDSTACK_CONFIG_PATH:-../../data/cardstack-salesforce.json} tsx watch src/main.ts",
    "migrate:flows-active": "tsx scripts/backfill-flow-active.ts"
  },
  "dependencies": {
    "@cardstack/core": "workspace:*",
    "@cardstack/config-store": "workspace:*",
    "@cardstack/crm-adapters": "workspace:*",
    "@cardstack/widgets": "workspace:*",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
